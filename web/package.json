{
  "name": "vmsctl-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prebuild.mjs && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.6.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
